+                | Domain('reinvoice_move_id', 'any', (
+                    Domain('payment_state', '=', 'reversed')
+                    | (Domain('state', '=', 'cancel') & Domain('payment_state', '!=', 'invoicing_legacy')
+                )))
+            )
