+            raise AccessError(_("You are not allowed to change the default privacy of a calendar you do not own."))
+
+        blacklisted_fields = [k for k in vals if k not in self._get_public_writable_fields()]
+        if blacklisted_fields and not self.env.su and any(self.env.user != calendar.owner_id for calendar in self):
+            raise AccessError(_("Only the calendar owner can modify these fields: %(fields)s", fields=", ".join(blacklisted_fields)))
