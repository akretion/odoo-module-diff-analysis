+
+    @api.depends('calendar_user_ids.access_role', 'calendar_user_ids.user_id')
+    def _compute_owner_id(self):
+        owner_records = self.env['calendar.user'].search([
+            ('access_role', '=', 'owner'),
+            ('calendar_id', 'in', self.ids),
+        ])
+        for calendar in self:
+            calendar.owner_id = owner_records.filtered(lambda l: l.calendar_id.id == calendar.id).user_id.id
+
+    @api.ondelete(at_uninstall=False)
+    def _unlink_except_primary(self):
+        if self.calendar_user_ids.filtered('is_primary'):
+            raise UserError(_("A primary calendar cannot be deleted."))
+
+    def add_filter_to_list(self):
+        self.calendar_user_id.is_filter_active = not self.calendar_user_id.is_filter_active
+        self.calendar_user_id.is_filter_checked = True
+
+    def unlink(self):
+        events = self.env['calendar.event'].with_context(active_test=False).search([('calendar_id', 'in', self.ids)])
+        recurrences = self.env['calendar.recurrence'].with_context(active_test=False).search([('calendar_id', 'in', self.ids)])
+        # We do not want to delete the events on Google - disconnect them before deletion
+        events._before_calendar_cascade_unlink()
+        recurrences._before_calendar_cascade_unlink()
+        events.unlink()
+        recurrences.unlink()
+        return super().unlink()
+
+    def _get_public_writable_fields(self):
+        """Sync modules can override this to allow write access to some fields."""
+        return set()

